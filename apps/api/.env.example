# Local development only. Choose your own password; never commit .env.
# Variable classification, defaults, and production value sources:
# docs/labs/lab-05/container-readiness.md
# Containers override HOST=0.0.0.0 and PORT (Cloud Run injects PORT).
# Production requires AUTH_COOKIE_SECURE=true and an exact HTTPS browser origin
# in AUTH_ALLOWED_ORIGINS. Inject DATABASE_URL/AUTH_JWT_SECRET at runtime only.
POSTGRES_USER=workflow
POSTGRES_DB=workflow_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://workflow:replace-with-a-local-password@localhost:5432/workflow_dev
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
AUTH_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
AUTH_JWT_ISSUER=workflow-approval-api
AUTH_JWT_AUDIENCE=workflow-approval-web
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_COOKIE_SECURE=false
# Used only by db:seed on loopback workflow_dev; choose separate local passwords.
DEV_REQUESTER_PASSWORD=replace-with-a-local-requester-password
DEV_REVIEWER_PASSWORD=replace-with-a-local-reviewer-password
