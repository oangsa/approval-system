# Copy to .env.test locally. Never use production credentials here.
NODE_ENV=test
TEST_POSTGRES_PORT=55432
TEST_POSTGRES_PASSWORD=replace-with-a-local-test-password
TEST_DATABASE_URL=postgresql://workflow_test:replace-with-a-local-test-password@127.0.0.1:55432/workflow_test
# Baseline for comparison only; never used by integration test connections.
DATABASE_URL=postgresql://127.0.0.1:5432/workflow_dev
AUTH_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
AUTH_JWT_ISSUER=workflow-approval-api
AUTH_JWT_AUDIENCE=workflow-approval-web
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
