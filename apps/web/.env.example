# Public browser configuration; never put secrets in VITE_ variables.
# VITE_API_BASE_URL is compiled at BUILD time, not read by the production server.
VITE_API_BASE_URL=/api
# Development proxy only. Production must route /api to the backend.
API_PROXY_TARGET=http://127.0.0.1:3001
# Production server accepts HOST (container default 0.0.0.0) and PORT (3000).
# Supply them as runtime environment variables; react-router-serve does not load
# this file. See docs/labs/lab-05/container-readiness.md for value sources.
