{
  "extends": "../../tsconfig.base.json",
  "include": ["app/**/*", "*.ts", ".react-router/types/**/*", "tests/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
